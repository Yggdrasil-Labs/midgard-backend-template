# 本地开发配置示例
# 使用方式：cp application-local.yml.example application-local.yml
# 然后根据本地环境修改配置

spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/midgard?useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: root

logging:
  level:
    io.yggdrasil.labs.midgard: debug

# local/dev 默认只允许 http://localhost:5173；协议、主机和端口均精确匹配。
# 如需额外来源，显式列出完整列表（覆盖默认值，不是追加）。
# mimir:
#   boot:
#     web:
#       cors:
#         allowed-origins:
#           - http://localhost:5173
#           - http://127.0.0.1:5173
